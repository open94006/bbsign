# Neon：用「Pooled connection」那條連線字串（主機名稱有 -pooler）
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/bbsign?sslmode=require
# Upstash：Redis 頁面的「rediss://」連線網址；本機開發可以不設（不快取、不限流）
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
# 只有爬蟲需要
ANTHROPIC_API_KEY=
# 管理頁密碼，至少 32 字元的隨機字串：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
